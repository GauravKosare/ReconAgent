# ---------- Database ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=reconagent

# ---------- LLM: free-tier failover chain (LiteLLM model strings) ----------
# The agent tries LLM_PRIMARY first, then each entry in LLM_FALLBACKS on
# rate-limit / error. If none are configured, unresolved clusters go to the
# human approval queue instead of being adjudicated.
LLM_PRIMARY=groq/qwen/qwen3.8-27b
LLM_FALLBACKS=groq/openai/gpt-oss-120b,gemini/gemini-flash-latest,openrouter/nvidia/nemotron-3.5-lightning:free,openrouter/z-ai/glm-5.2:free

# Provider keys — set only the ones you actually use.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# GitHub Models closed to new signups (June 2026). Leave blank unless your account
# already has active usage; then a GitHub PAT with the "models" scope is the key
# and you can append github/gpt-4o-mini to the chain.
GITHUB_MODELS_TOKEN=

# Cheap model for the "is this cluster even ambiguous?" triage pass (optional).
LLM_TRIAGE=gemini/gemini-2.0-flash

# ---------- Embeddings for semantic narration matching ----------
# Uses a free hosted embedding endpoint; leave blank to disable semantic match.
EMBEDDINGS_MODEL=gemini/text-embedding-004

# ---------- Routing policy (bounded money actions) ----------
AUTO_RESOLVE_MIN_CONFIDENCE=0.90
AUTO_RESOLVE_MAX_IMPACT_INR=500
# Exception codes allowed to auto-resolve (comma-separated). Everything else is
# always sent to a human regardless of confidence.
AUTO_RESOLVE_ALLOWED_CODES=TIMING_GAP,DUPLICATE,FEE_MISMATCH

# ---------- Settlement assumptions ----------
SETTLEMENT_SLA_DAYS=2
DEFAULT_MDR_PERCENT=2.0
DEFAULT_GST_PERCENT=18.0

# ---------- Optional: batch queue ----------
REDIS_URL=

# ---------- App ----------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
